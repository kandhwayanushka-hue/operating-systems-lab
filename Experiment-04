#include <iostream>
using namespace std;

int main()
{
    int bt[20], p[20], wt[20], tat[20];
    int i, j, n;

    float avg_wt = 0, avg_tat = 0;

    // Input: Number of Processes
    cout << "Enter number of processes: ";
    cin >> n;
    // Input: Burst Time
    cout << "\nEnter Burst Time:\n";
    for (i = 0; i < n; i++)
    {
        cout << "P" << i + 1 << ": ";
        cin >> bt[i];
        p[i] = i + 1;
    }

   



 // Sorting by Burst Time (SJF Logic)
    // Insertion Sort
    for (i = 1; i < n; i++)
    {
        int key_bt = bt[i];
        int key_p = p[i];

        j = i - 1;

        while (j >= 0 && bt[j] > key_bt)
        {
            bt[j + 1] = bt[j];
            p[j + 1] = p[j];

            j--;
        }
        bt[j + 1] = key_bt;
        p[j + 1] = key_p;
    }

  



  // Calculate Waiting Time
    wt[0] = 0;

    for (i = 1; i < n; i++)
    {
        wt[i] = wt[i - 1] + bt[i - 1];
    }

    // Calculate Turnaround Time
    for (i = 0; i < n; i++)
    {
        tat[i] = wt[i] + bt[i];

        avg_wt += wt[i];
        avg_tat += tat[i];
    }

    // Calculate Average
    avg_wt = avg_wt / n;
    avg_tat = avg_tat / n;





    // OUTPUT
    cout << "\nProcess\tBurst Time\tWaiting Time\tTurnaround Time\n";

    for (i = 0; i < n; i++)
    {
        cout << "P" << p[i] << "\t\t"
             << bt[i] << "\t\t"
             << wt[i] << "\t\t"
             << tat[i] << endl;
    }

    cout << "\nAverage Waiting Time = " << avg_wt;
    cout << "\nAverage Turnaround Time = " << avg_tat << endl;

    return 0;
}
